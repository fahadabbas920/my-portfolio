# Public site URL used for canonical links, sitemap and Open Graph metadata.
# Set this to your production domain when you deploy.
NEXT_PUBLIC_SITE_URL=https://fahadabbas.dev

# Resend API key, used by the /api/contact route to send contact form
# submissions to your inbox. Get one at https://resend.com/api-keys
# Server-only — never expose this with a NEXT_PUBLIC_ prefix.
RESEND_API_KEY=re_api_key
